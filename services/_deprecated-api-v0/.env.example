# App
APP_NAME=GoAn API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql://goan:goan_password@localhost:5432/goan_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Payment gateways (điền khi có tài khoản đối tác thật)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# eKYC provider
EKYC_PROVIDER_API_KEY=
EKYC_PROVIDER_BASE_URL=

# SMS/OTP
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_BASE_URL=

# Maps
MAPS_PROVIDER_API_KEY=

# Pricing defaults (VND) - có thể override qua bảng pricing_rules trong DB
PRICING_BASE_FEE=30000
PRICING_MIN_FARE_NORMAL=100000
