# --- App ---
APP_NAME=GoAn Backend
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
LOCAL_TZ=Asia/Ho_Chi_Minh

# --- Hạ tầng ---
DATABASE_URL=postgresql+asyncpg://goan:goan@localhost:5432/goan
DB_ECHO=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# --- Phân bổ doanh thu (SPEC 4.4) ---
DRIVER_SHARE_RATE=0.58
TAKE_RATE=0.38
PAYMENT_GATEWAY_FEE_RATE=0.02
INSURANCE_FEE_RATE=0.06

# --- Phụ thu đón xa (SPEC 4.3) ---
PICKUP_FREE_RADIUS_KM=5
PICKUP_SURCHARGE_AMOUNT=20000

# --- Ký quỹ (SPEC 8) ---
ESCROW_ACCRUAL_RATE=0.15
ESCROW_DEFAULT_TARGET=3000000
ESCROW_REFUND_DELAY_DAYS=45

# --- Matching (SPEC 6) ---
MATCHING_OFFER_FANOUT=5
MATCHING_TIMEOUT_SECONDS=90
MATCHING_OFFER_TTL_SECONDS=20
NEW_ZONE_SUBSIDY_AMOUNT=20000

# --- Chống gian lận (SPEC 7) ---
ROUTE_DEVIATION_FACTOR=1.5
ROUTE_DEVIATION_PENALTY_MULTIPLIER=2
FRAUD_STRIKE_LOCK_THRESHOLD=3
SELFIE_MATCH_THRESHOLD=0.85

# --- Chuyến / ví ---
CANCELLATION_GRACE_MINUTES=5
CANCELLATION_FEE=20000
WALLET_HOLD_HOURS=24
TRIP_COMPLETE_RADIUS_M=300

# --- Hardening ---
RATE_LIMIT_PER_MINUTE=120
JSON_LOGS=true

# --- Bảo mật CCCD (SPEC 13) ---
NATIONAL_ID_ENCRYPTION_KEY=dev-only-32-bytes-key-change-me!
